# ============================================================================
# NEXUSDL - Git Ignore
# ============================================================================
# Fichier .gitignore complet pour le projet Nexus-DL
# Couvre : Python, Node.js, IDE, OS, Docker, CI/CD, données, logs, secrets
# ============================================================================

# ============================================================================
# ENVIRONNEMENT & SECRETS (CRITIQUE)
# ============================================================================
# Ignorer tous les fichiers .env SAUF .env.example
.env
.env.local
.env.production
.env.development
.env.staging
*.env
*.env.*
!*.env.example
!.env.example

# Secrets et certificats
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/

