# ============================================================================
# EXCEPTIONS (FICHIERS À TRACKER MALGRÉ TOUT)
# ============================================================================

# Garder les fichiers d'exemple
!*.example
!.env.example
!config.example.yaml
!config.example.yml

# Garder les fichiers de configuration importants
!.gitignore
!.gitattributes
!.editorconfig
!LICENSE
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md

# Garder les configurations CI/CD
!.github/
!.gitlab-ci.yml
!.travis.yml

# Garder les configurations Docker
!Dockerfile
!docker-compose.yml
!.dockerignore

# Garder les configurations de build
!pyproject.toml
!requirements*.txt
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Garder les configurations de test
!pytest.ini
!setup.cfg
!tox.ini

# Garder les configurations de linting
!.eslintrc*
!.prettierrc*
!.stylelintrc*
!ruff.toml
!.ruff.toml

# Garder les configurations TypeScript
!tsconfig*.json
!jsconfig*.json

# Garder les configurations Next.js
!next.config.*
!postcss.config.*
!tailwind.config.*

