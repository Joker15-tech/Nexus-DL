# ==============================================================================
#  NexusDL — .env.example
# ==============================================================================
#  Template des variables d'environnement pour NexusDL.
#
#  UTILISATION :
#    1. Copier ce fichier : cp .env.example .env
#    2. Éditer .env avec vos valeurs
#    3. NE JAMAIS COMMITER le fichier .env (il est dans .gitignore)
#
#  PRIORITÉ DE CHARGEMENT :
#    1. Variables d'environnement du système (les plus hautes)
#    2. Fichier .env (ce template, une fois copié)
#    3. Fichier config.yaml
#    4. Valeurs par défaut du code
#
#  FORMAT :
#    KEY=value            # Valeur simple
#    KEY="value with spaces"
#    KEY='value with $vars'   # Pas d'expansion
#    # Commentaire
#
#  NE PAS METTRE D'ESPACES autour du `=`
#    ✅ BON  : DATABASE_URL=sqlite:///data/nexusdl.db
#    ❌ MAUVAIS : DATABASE_URL = sqlite:///data/nexusdl.db
#
#  Copyright (C) 2026 NEXUS-QUANTUM
#  SPDX-License-Identifier: GPL-3.0-or-later
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
#  1. GÉNÉRAL
# ══════════════════════════════════════════════════════════════════════════════

# Environnement d'exécution
# Valeurs possibles : development, staging, production, testing
NEXUSDL_ENV=development

# Niveau de log
# Valeurs possibles : TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
NEXUSDL_LOG_LEVEL=INFO

# Format des logs
# Valeurs possibles : text, json, pretty
NEXUSDL_LOG_FORMAT=text

# Dossier de logs (relatif ou absolu)
NEXUSDL_LOG_DIR=./.nexusdl/logs

# Rotation des logs : taille max avant rotation
NEXUSDL_LOG_MAX_SIZE=10 MB

# Rétention des logs
NEXUSDL_LOG_RETENTION=30 days

# Compression des logs
# Valeurs possibles : true, false
NEXUSDL_LOG_COMPRESSION=true

# Langue de l'interface
# Valeurs possibles : fr, en, es, de, it, pt, ja, ko, zh
NEXUSDL_LANGUAGE=fr

# Thème de l'interface
# Valeurs possibles : light, dark, auto
NEXUSDL_THEME=dark

# Fuseau horaire
# Format : Area/City (ex: Europe/Paris)
NEXUSDL_TIMEZONE=Europe/Paris

# Fichier de configuration YAML (optionnel)
# Si vide, utilise les chemins XDG par défaut
# NEXUSDL_CONFIG_FILE=./config.yaml


# ══════════════════════════════════════════════════════════════════════════════
#  2. SÉCURITÉ (CRITIQUE — À CHANGER EN PRODUCTION)
# ══════════════════════════════════════════════════════════════════════════════

# --- Clé secrète principale ---
# Utilisée pour signer les sessions, JWT, cookies chiffrés.
# Génération : openssl rand -hex 32
# ⚠️ NE JAMAIS partager ni commiter cette valeur
NEXUSDL_SECRET_KEY=change-me-to-a-random-64-char-hex-string-please

# --- Clé JWT (interface web) ---
# Clé séparée pour les tokens JWT
# Génération : openssl rand -hex 32
NEXUSDL_JWT_SECRET=change-me-too-another-random-64-char-hex-string

# Algorithme de signature JWT
# Valeurs possibles : HS256, HS384, HS512
NEXUSDL_JWT_ALGORITHM=HS256

# Durée de vie des tokens JWT (en minutes)
NEXUSDL_JWT_EXPIRE_MINUTES=1440

# --- Chiffrement des cookies ---
# Clé Fernet pour chiffrer les cookies au repos
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUSDL_COOKIE_ENCRYPTION_KEY=change-me-fernet-key-base64-encoded-44-chars=

# Activer le chiffrement des cookies
NEXUSDL_COOKIE_ENCRYPTION_ENABLED=true

# --- Sel pour le hachage de mots de passe ---
# Utilisé pour bcrypt (interface web multi-utilisateurs)
NEXUSDL_PASSWORD_SALT=change-me-random-salt-for-passwords

# --- CORS (interface web) ---
# Origines autorisées (séparées par des virgules)
# ⚠️ En production, remplacer par vos vrais domaines
NEXUSDL_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# --- Rate limiting ---
# Requêtes max par minute par IP
NEXUSDL_RATE_LIMIT_PER_MINUTE=60

# --- HTTPS (production) ---
# Forcer HTTPS sur l'interface web
NEXUSDL_FORCE_HTTPS=false

# Hôtes autorisés (Host header validation)
NEXUSDL_ALLOWED_HOSTS=localhost,127.0.0.1,nexusdl.local

# --- Trusted proxies ---
# IPs des reverse proxies de confiance (nginx, traefik)
# Format : liste séparée par virgules, ou "*" pour tout (déconseillé)
NEXUSDL_TRUSTED_PROXIES=127.0.0.1,::1


# ══════════════════════════════════════════════════════════════════════════════
#  3. BASE DE DONNÉES
# ══════════════════════════════════════════════════════════════════════════════

# URL de connexion à la base de données
# SQLite (par défaut) : sqlite+aiosqlite:///chemin/vers/nexusdl.db
# PostgreSQL (avancé)  : postgresql+asyncpg://user:pass@host:5432/nexusdl
# MySQL (avancé)       : mysql+aiomysql://user:pass@host:3306/nexusdl
NEXUSDL_DATABASE_URL=sqlite+aiosqlite:///./.nexusdl/data/library.db

# Activer le mode WAL (SQLite uniquement, recommandé)
NEXUSDL_DATABASE_WAL=true

# Timeout de connexion (secondes)
NEXUSDL_DATABASE_TIMEOUT=30

# Taille du pool de connexions
NEXUSDL_DATABASE_POOL_SIZE=10

# Taille max du pool (overflow)
NEXUSDL_DATABASE_MAX_OVERFLOW=20

# Echo SQL (debug uniquement)
NEXUSDL_DATABASE_ECHO=false

# Activer les migrations automatiques au démarrage
NEXUSDL_DATABASE_AUTO_MIGRATE=true

# Chemin des backups
NEXUSDL_BACKUP_DIR=./.nexusdl/backups


# ══════════════════════════════════════════════════════════════════════════════
#  4. TÉLÉCHARGEMENT
# ══════════════════════════════════════════════════════════════════════════════

# Dossier de destination des mangas téléchargés
NEXUSDL_DOWNLOAD_DIR=./downloads

# Format de sortie par défaut
# Valeurs possibles : zip, cbz, cbr, pdf, folder
NEXUSDL_DOWNLOAD_FORMAT=cbz

# Écraser les fichiers existants
NEXUSDL_DOWNLOAD_OVERWRITE=false

# Nombre max de tâches simultanées (manga différents)
NEXUSDL_DOWNLOAD_MAX_TASKS=3

# Nombre max de pages simultanées par chapitre
NEXUSDL_DOWNLOAD_MAX_PAGES=8

# Nombre max de chapitres simultanés dans une tâche
NEXUSDL_DOWNLOAD_MAX_CHAPTERS=2

# Timeout HTTP (secondes)
NEXUSDL_DOWNLOAD_TIMEOUT=30

# Timeout de connexion (secondes)
NEXUSDL_DOWNLOAD_CONNECT_TIMEOUT=10

# Nombre de tentatives en cas d'échec
NEXUSDL_DOWNLOAD_RETRY_ATTEMPTS=3

# Facteur de backoff exponentiel
NEXUSDL_DOWNLOAD_RETRY_BACKOFF=2.0

# Taille du chunk de téléchargement (bytes)
NEXUSDL_DOWNLOAD_CHUNK_SIZE=65536

# Déduplication par hash
NEXUSDL_DOWNLOAD_DEDUPLICATION=true

# Taille max d'une image (Mo)
NEXUSDL_DOWNLOAD_MAX_IMAGE_SIZE_MB=50

# Générer ComicInfo.xml dans les CBZ
NEXUSDL_DOWNLOAD_COMIC_INFO=true

# Nombre de threads pour la compression ZIP
NEXUSDL_DOWNLOAD_ZIP_COMPRESSION_LEVEL=6


# ══════════════════════════════════════════════════════════════════════════════
#  5. RÉSEAU / HTTP
# ══════════════════════════════════════════════════════════════════════════════

# Proxy HTTP/HTTPS (vide = pas de proxy)
# Format : http://user:pass@host:port
# NEXUSDL_HTTP_PROXY=http://proxy.example.com:8080

# Proxy SOCKS5
# Format : socks5://user:pass@host:port
# NEXUSDL_SOCKS_PROXY=socks5://127.0.0.1:1080

# Rotation des User-Agents
NEXUSDL_USER_AGENT_ROTATION=true

# User-Agent personnalisé (vide = aléatoire)
# NEXUSDL_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# Activer HTTP/2
NEXUSDL_HTTP2=true

# Activer les cookies persistants
NEXUSDL_COOKIES_PERSISTENT=true

# Fichier de cookies (chemin)
NEXUSDL_COOKIES_FILE=./.nexusdl/cookies.enc

# Utiliser FlareSolverr pour Cloudflare
NEXUSDL_FLARESOLVERR_ENABLED=false

# URL de FlareSolverr
NEXUSDL_FLARESOLVERR_URL=http://localhost:8191/v1

# Timeout FlareSolverr (secondes)
NEXUSDL_FLARESOLVERR_TIMEOUT=60

# Utiliser Playwright pour Cloudflare
NEXUSDL_PLAYWRIGHT_ENABLED=true

# Nombre max de navigateurs Playwright en parallèle
NEXUSDL_PLAYWRIGHT_MAX_CONTEXTS=2

# Mode headless (true = invisible)
NEXUSDL_PLAYWRIGHT_HEADLESS=true

# Timeout Playwright (secondes)
NEXUSDL_PLAYWRIGHT_TIMEOUT=30

# Cache des navigateurs Playwright
NEXUSDL_PLAYWRIGHT_BROWSERS_PATH=./.nexusdl/playwright

# --- Rate limiting par site ---
# Requêtes par seconde (défaut global, peut être override par site)
NEXUSDL_RATE_LIMIT_DEFAULT=2.0

# Délai minimum entre deux requêtes (secondes)
NEXUSDL_RATE_LIMIT_MIN_DELAY=0.5

# Backoff en cas de 429 (facteur)
NEXUSDL_RATE_LIMIT_BACKOFF=2.0


# ══════════════════════════════════════════════════════════════════════════════
#  6. IMAGES
# ══════════════════════════════════════════════════════════════════════════════

# Convertir les images en JPEG
NEXUSDL_IMAGE_CONVERT_TO_JPEG=false

# Convertir les images en WebP
NEXUSDL_IMAGE_CONVERT_TO_WEBP=false

# Qualité JPEG (1-100)
NEXUSDL_IMAGE_JPEG_QUALITY=90

# Qualité WebP (1-100)
NEXUSDL_IMAGE_WEBP_QUALITY=85

# Optimiser les images (compression)
NEXUSDL_IMAGE_OPTIMIZE=false

# Supprimer les images corrompues
NEXUSDL_IMAGE_REMOVE_CORRUPT=true

# Taille max d'une image (pixels, largeur ou hauteur)
NEXUSDL_IMAGE_MAX_DIMENSION=8000

# Watermark (fichier image, vide = pas de watermark)
# NEXUSDL_IMAGE_WATERMARK_FILE=./assets/watermark.png

# Position du watermark
# Valeurs possibles : top-left, top-right, bottom-left, bottom-right, center
NEXUSDL_IMAGE_WATERMARK_POSITION=bottom-right

# Opacité du watermark (0-100)
NEXUSDL_IMAGE_WATERMARK_OPACITY=30


# ══════════════════════════════════════════════════════════════════════════════
#  7. BIBLIOTHÈQUE LOCALE
# ══════════════════════════════════════════════════════════════════════════════

# Activer la bibliothèque locale
NEXUSDL_LIBRARY_ENABLED=true

# Scanner la bibliothèque au démarrage
NEXUSDL_LIBRARY_SCAN_ON_STARTUP=false

# Fréquence de scan automatique (heures, 0 = désactivé)
NEXUSDL_LIBRARY_SCAN_INTERVAL=24

# Extensions de fichiers reconnues
NEXUSDL_LIBRARY_EXTENSIONS=.cbz,.cbr,.zip,.pdf,.epub

# Taille max d'un fichier à scanner (Mo)
NEXUSDL_LIBRARY_MAX_FILE_SIZE_MB=500

# Dossiers à scanner (séparés par virgules)
NEXUSDL_LIBRARY_SCAN_DIRS=./downloads

# Extraire les métadonnées ComicInfo.xml
NEXUSDL_LIBRARY_EXTRACT_METADATA=true

# Télécharger les covers manquantes
NEXUSDL_LIBRARY_FETCH_COVERS=true

# Dossier de cache des covers
NEXUSDL_LIBRARY_COVERS_CACHE=./.nexusdl/cache/covers


# ══════════════════════════════════════════════════════════════════════════════
#  8. INTERFACE WEB (BACKEND)
# ══════════════════════════════════════════════════════════════════════════════

# Hôte d'écoute du backend FastAPI
NEXUSDL_WEB_HOST=0.0.0.0

# Port d'écoute
NEXUSDL_WEB_PORT=8000

# Nombre de workers uvicorn (0 = auto)
NEXUSDL_WEB_WORKERS=1

# Mode reload (développement)
NEXUSDL_WEB_RELOAD=false

# Activer l'authentification
NEXUSDL_WEB_AUTH_ENABLED=true

# Activer l'inscription publique
NEXUSDL_WEB_ALLOW_REGISTRATION=false

# Admin par défaut (créé au premier démarrage)
NEXUSDL_WEB_ADMIN_USERNAME=admin
NEXUSDL_WEB_ADMIN_PASSWORD=change-me-admin-password
NEXUSDL_WEB_ADMIN_EMAIL=admin@nexus-quantum.dev

# Activer les WebSockets pour progression temps réel
NEXUSDL_WEB_WEBSOCKETS=true

# Timeout WebSocket (secondes)
NEXUSDL_WEB_WS_TIMEOUT=300

# Activer Swagger UI (/docs)
NEXUSDL_WEB_SWAGGER=true

# Activer ReDoc (/redoc)
NEXUSDL_WEB_REDOC=true

# Préfixe de l'API
NEXUSDL_WEB_API_PREFIX=/api


# ══════════════════════════════════════════════════════════════════════════════
#  9. INTERFACE WEB (FRONTEND)
# ══════════════════════════════════════════════════════════════════════════════

# URL du backend (côté client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Nom de l'application
NEXT_PUBLIC_APP_NAME=NexusDL

# Version (affichée dans l'UI)
NEXT_PUBLIC_APP_VERSION=1.0.0

# Activer le mode debug
NEXT_PUBLIC_DEBUG=false

# Analytics (désactivé par défaut)
NEXT_PUBLIC_ANALYTICS_ENABLED=false


# ══════════════════════════════════════════════════════════════════════════════
#  10. INTERFACE DESKTOP (GUI)
# ══════════════════════════════════════════════════════════════════════════════

# Thème de l'interface desktop
# Valeurs possibles : light, dark, auto
NEXUSDL_GUI_THEME=dark

# Taille de la fenêtre
NEXUSDL_GUI_WINDOW_WIDTH=1280
NEXUSDL_GUI_WINDOW_HEIGHT=800

# Démarrer maximisé
NEXUSDL_GUI_START_MAXIMIZED=false

# Système de notifications desktop
NEXUSDL_GUI_NOTIFICATIONS=true

# Minimiser dans la barre des tâches au lieu de fermer
NEXUSDL_GUI_MINIMIZE_TO_TRAY=true


# ══════════════════════════════════════════════════════════════════════════════
#  11. CONTENU ADULTE (18+)
# ══════════════════════════════════════════════════════════════════════════════

# Activer les sources adultes (18+)
# ⚠️ Vous devez être majeur dans votre juridiction
NEXUSDL_ADULT_ENABLED=false

# Demander confirmation avant d'accéder au contenu adulte
NEXUSDL_ADULT_REQUIRE_CONFIRMATION=true

# Filtrer le contenu adulte dans la recherche
NEXUSDL_ADULT_FILTER_SEARCH=true

# Sites adultes désactivés individuellement (séparés par virgules)
# NEXUSDL_ADULT_DISABLED_SITES=nhentai

# Sites adultes activés (vide = tous ceux activés globalement)
# NEXUSDL_ADULT_ENABLED_SITES=hentaizone,nhentai


# ══════════════════════════════════════════════════════════════════════════════
#  12. NOTIFICATIONS
# ══════════════════════════════════════════════════════════════════════════════

# Activer les notifications
NEXUSDL_NOTIFY_ENABLED=false

# Événements déclencheurs
# Valeurs possibles : download_complete, download_failed, library_scan, all
NEXUSDL_NOTIFY_EVENTS=download_complete,download_failed

# --- Notifications Discord ---
NEXUSDL_NOTIFY_DISCORD_ENABLED=false
# NEXUSDL_NOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy

# --- Notifications Telegram ---
NEXUSDL_NOTIFY_TELEGRAM_ENABLED=false
# NEXUSDL_NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# NEXUSDL_NOTIFY_TELEGRAM_CHAT_ID=123456789

# --- Notifications ntfy.sh ---
NEXUSDL_NOTIFY_NTFY_ENABLED=false
# NEXUSDL_NOTIFY_NTFY_URL=https://ntfy.sh/nexusdl-mon-channel

# --- Notifications email (SMTP) ---
NEXUSDL_NOTIFY_EMAIL_ENABLED=false
# NEXUSDL_NOTIFY_EMAIL_SMTP_HOST=smtp.gmail.com
# NEXUSDL_NOTIFY_EMAIL_SMTP_PORT=587
# NEXUSDL_NOTIFY_EMAIL_SMTP_USER=your-email@gmail.com
# NEXUSDL_NOTIFY_EMAIL_SMTP_PASSWORD=your-app-password
# NEXUSDL_NOTIFY_EMAIL_FROM=nexusdl@your-domain.com
# NEXUSDL_NOTIFY_EMAIL_TO=you@your-domain.com

# --- Notifications Pushover ---
NEXUSDL_NOTIFY_PUSHOVER_ENABLED=false
# NEXUSDL_NOTIFY_PUSHOVER_TOKEN=your-app-token
# NEXUSDL_NOTIFY_PUSHOVER_USER=your-user-key


# ══════════════════════════════════════════════════════════════════════════════
#  13. SYNCHRONISATION CLOUD
# ══════════════════════════════════════════════════════════════════════════════

# Activer la synchronisation
NEXUSDL_SYNC_ENABLED=false

# Direction de la synchronisation
# Valeurs possibles : upload, download, bidirectional
NEXUSDL_SYNC_DIRECTION=bidirectional

# Fréquence de sync (minutes, 0 = manuel)
NEXUSDL_SYNC_INTERVAL=60

# --- WebDAV (Nextcloud, ownCloud) ---
NEXUSDL_SYNC_WEBDAV_ENABLED=false
# NEXUSDL_SYNC_WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/user/
# NEXUSDL_SYNC_WEBDAV_USER=your-username
# NEXUSDL_SYNC_WEBDAV_PASSWORD=your-password-or-app-token

# --- Amazon S3 (ou compatible : MinIO, Wasabi) ---
NEXUSDL_SYNC_S3_ENABLED=false
# NEXUSDL_SYNC_S3_BUCKET=nexusdl-backup
# NEXUSDL_SYNC_S3_REGION=eu-west-1
# NEXUSDL_SYNC_S3_ACCESS_KEY=your-access-key
# NEXUSDL_SYNC_S3_SECRET_KEY=your-secret-key
# NEXUSDL_SYNC_S3_ENDPOINT=https://s3.amazonaws.com
# NEXUSDL_SYNC_S3_PREFIX=nexusdl/

# --- Google Drive ---
NEXUSDL_SYNC_GDRIVE_ENABLED=false
# NEXUSDL_SYNC_GDRIVE_CREDENTIALS_FILE=./credentials.json
# NEXUSDL_SYNC_GDRIVE_FOLDER_ID=your-folder-id


# ══════════════════════════════════════════════════════════════════════════════
#  14. DÉVELOPPEMENT / DEBUG
# ══════════════════════════════════════════════════════════════════════════════

# Mode debug (verbose)
NEXUSDL_DEBUG=false

# Mode dev (hot reload, traces)
NEXUSDL_DEV_MODE=false

# Afficher les stack traces complètes
NEXUSDL_SHOW_TRACEBACK=true

# Sauvegarder les réponses HTTP pour debug
NEXUSDL_DEBUG_SAVE_HTTP=false

# Dossier des réponses HTTP sauvegardées
NEXUSDL_DEBUG_HTTP_DIR=./.nexusdl/debug/http

# Activer le profiling (py-spy, memray)
NEXUSDL_DEBUG_PROFILING=false

# Seed pour la reproductibilité (tests)
# NEXUSDL_DEBUG_SEED=42

# Ne pas effectuer de vraies requêtes HTTP (tests offline)
NEXUSDL_DEBUG_OFFLINE=false

# Ne pas effectuer de vrais téléchargements
NEXUSDL_DEBUG_DRY_RUN=false


# ══════════════════════════════════════════════════════════════════════════════
#  15. TESTS
# ══════════════════════════════════════════════════════════════════════════════

# Activer les tests E2E (réseau réel)
NEXUSDL_E2E=0

# Activer les tests adultes
NEXUSDL_ADULT_TESTS=0

# Activer les tests Cloudflare
NEXUSDL_CLOUDFLARE_TESTS=0

# Timeout des tests (secondes)
NEXUSDL_TEST_TIMEOUT=60

# Utiliser un serveur HTTP mocké
NEXUSDL_TEST_MOCK_HTTP=1

# Dossier des fixtures de test
NEXUSDL_TEST_FIXTURES=./tests/fixtures


# ══════════════════════════════════════════════════════════════════════════════
#  16. CI/CD
# ══════════════════════════════════════════════════════════════════════════════

# Mode CI (GitHub Actions, GitLab CI, etc.)
CI=false

# Token GitHub (pour release automatique)
# ⚠️ Ne pas définir dans .env — utiliser les secrets CI
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Token PyPI (pour publication)
# ⚠️ Ne pas définir dans .env — utiliser les secrets CI
# PYPI_API_TOKEN=pypi-xxxxxxxxxxxxx

# Token TestPyPI
# TESTPYPI_API_TOKEN=pypi-xxxxxxxxxxxxx


# ══════════════════════════════════════════════════════════════════════════════
#  17. DOCKER
# ══════════════════════════════════════════════════════════════════════════════

# Utilisateur dans le conteneur (UID)
NEXUSDL_DOCKER_UID=1000

# Groupe dans le conteneur (GID)
NEXUSDL_DOCKER_GID=1000

# Timezone du conteneur
NEXUSDL_DOCKER_TZ=Europe/Paris

# Chemin des données dans le conteneur
NEXUSDL_DOCKER_DATA_DIR=/data

# Chemin de la config dans le conteneur
NEXUSDL_DOCKER_CONFIG_DIR=/config

# Chemin des téléchargements dans le conteneur
NEXUSDL_DOCKER_DOWNLOAD_DIR=/downloads


# ══════════════════════════════════════════════════════════════════════════════
#  18. VARIABLES SPÉCIFIQUES PAR SITE
# ══════════════════════════════════════════════════════════════════════════════
#  Pour les sites nécessitant une authentification ou des cookies spéciaux,
#  vous pouvez définir des variables spécifiques.
#
#  Format : NEXUSDL_SITE_<SITE_ID>_<VAR>=value
# ==============================================================================

# --- SushiScan (si nécessaire) ---
# NEXUSDL_SITE_SUSHISCAN_COOKIES=cf_clearance=xxx; session=yyy

# --- MangaDex (API officielle, pas de cookies nécessaires) ---
# Optionnel : personnaliser le User-Agent pour respecter les quotas
# NEXUSDL_SITE_MANGADEX_USER_AGENT="NexusDL/1.0.0 (https://github.com/NEXUS-QUANTUM/nexusdl)"

# --- nHentai (cookies si accès restreint) ---
# NEXUSDL_SITE_NHENTAI_COOKIES=cf_clearance=xxx

# --- HentaiZone (Cloudflare) ---
# NEXUSDL_SITE_HENTAIZONE_COOKIES=cf_clearance=xxx

# --- Scan-Manga (Cloudflare) ---
# NEXUSDL_SITE_SCANMANGA_COOKIES=cf_clearance=xxx


# ══════════════════════════════════════════════════════════════════════════════
#  19. VARIABLES AVANCÉES
# ══════════════════════════════════════════════════════════════════════════════

# Nombre de workers asyncio par défaut
NEXUSDL_ASYNCIO_WORKERS=4

# Taille du pool de threads pour les opérations bloquantes
NEXUSDL_THREAD_POOL_SIZE=8

# Utiliser uvloop (Linux/macOS uniquement, plus rapide)
NEXUSDL_USE_UVLOOP=true

# Utiliser orjson (plus rapide que json stdlib)
NEXUSDL_USE_ORJSON=true

# Activer le cache LRU des requêtes HTTP
NEXUSDL_CACHE_HTTP=true

# Taille du cache HTTP (entrées)
NEXUSDL_CACHE_HTTP_SIZE=1000

# Durée de vie du cache HTTP (secondes)
NEXUSDL_CACHE_HTTP_TTL=3600

# Activer le cache des métadonnées manga
NEXUSDL_CACHE_METADATA=true

# TTL du cache métadonnées (secondes)
NEXUSDL_CACHE_METADATA_TTL=86400

# Activer le cache des images
NEXUSDL_CACHE_IMAGES=true

# Taille max du cache images (Mo)
NEXUSDL_CACHE_IMAGES_MAX_MB=500


# ══════════════════════════════════════════════════════════════════════════════
#  20. SENTRY (MONITORING, OPTIONNEL)
# ══════════════════════════════════════════════════════════════════════════════

# Activer Sentry pour le monitoring d'erreurs
NEXUSDL_SENTRY_ENABLED=false

# DSN Sentry
# NEXUSDL_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# Environnement Sentry
NEXUSDL_SENTRY_ENVIRONMENT=production

# Taux d'échantillonnage des traces (0.0 - 1.0)
NEXUSDL_SENTRY_TRACES_SAMPLE_RATE=0.1

# Envoyer les PII (données personnelles)
NEXUSDL_SENTRY_SEND_PII=false


# ══════════════════════════════════════════════════════════════════════════════
#  21. PROMETHEUS (MÉTRIQUES, OPTIONNEL)
# ══════════════════════════════════════════════════════════════════════════════

# Activer l'endpoint Prometheus (/metrics)
NEXUSDL_PROMETHEUS_ENABLED=false

# Port Prometheus
NEXUSDL_PROMETHEUS_PORT=9090

# Chemin de l'endpoint
NEXUSDL_PROMETHEUS_PATH=/metrics


# ══════════════════════════════════════════════════════════════════════════════
#  NOTES & RAPPELS
# ══════════════════════════════════════════════════════════════════════════════
#
#  1. SÉCURITÉ
#     - NE JAMAIS commiter le fichier .env
#     - Générer des secrets forts : openssl rand -hex 32
#     - En production, utiliser un gestionnaire de secrets
#       (Vault, AWS Secrets Manager, Doppler, 1Password)
#     - Régénérer les clés si compromission suspectée
#
#  2. PRIORITÉ DE CHARGEMENT
#     Variables d'environnement système > .env > config.yaml > défauts
#
#  3. VARIABLES PAR SITE
#     Les variables NEXUSDL_SITE_<SITE_ID>_<VAR> permettent de
#     surcharger la configuration par site sans modifier sites.yaml.
#
#  4. VALEURS BOOLÉENNES
#     Acceptées : true, false, 1, 0, yes, no, on, off
#
#  5. LISTES
#     Utiliser des virgules comme séparateur :
#     NEXUSDL_CORS_ORIGINS=http://a.com,http://b.com
#
#  6. COMMENTAIRES
#     Les lignes commençant par # sont ignorées.
#     Les variables commentées (# KEY=value) sont des exemples à décommenter.
#
#  7. VALIDATION
#     Les valeurs sont validées par Pydantic Settings au démarrage.
#     Une valeur invalide causera une erreur explicite.
#
#  8. TESTER VOTRE CONFIGURATION
#     - nexusdl config validate
#     - nexusdl config show
#     - nexusdl config get NEXUSDL_DOWNLOAD_DIR
#
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
#  22. CONFIGURATION MINIMALE (POUR DÉMARRER RAPIDEMENT)
# ══════════════════════════════════════════════════════════════════════════════
#  Si vous êtes pressé, voici les 5 variables à définir au minimum :
#
#  NEXUSDL_SECRET_KEY=<openssl rand -hex 32>
#  NEXUSDL_JWT_SECRET=<openssl rand -hex 32>
#  NEXUSDL_COOKIE_ENCRYPTION_KEY=<Fernet key>
#  NEXUSDL_WEB_ADMIN_PASSWORD=<mot de passe fort>
#  NEXUSDL_DOWNLOAD_DIR=./downloads
#
#  Commande pour générer tous les secrets d'un coup :
#
#      nexusdl config generate-secrets >> .env
#
# ══════════════════════════════════════════════════════════════════════════════
