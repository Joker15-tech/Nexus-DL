# ============================================================================
# NEXUSDL - Environment Variables Example
# ============================================================================
# Instructions :
# 1. Copiez ce fichier et renommez-le en `.env` (pour le dev local) ou 
#    configurez ces variables dans votre plateforme de déploiement (Railway, Netlify, etc.).
# 2. Ne commitez JAMAIS votre fichier `.env` réel dans Git.
# 3. Les valeurs par défaut ci-dessous sont prévues pour le développement local.
# ============================================================================

# ============================================================================
# 1. CONFIGURATION GÉNÉRALE (Backend & Frontend)
# ============================================================================

# Environnement d'exécution (development, production, test)
NEXUSDL_ENV=development

# Niveau de log (TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL)
NEXUSDL_LOG_LEVEL=DEBUG

# Nom et version de l'application
NEXUSDL_APP_NAME=NexusDL
NEXUSDL_APP_VERSION=0.1.0

# ============================================================================
# 2. SÉCURITÉ & AUTHENTIFICATION (Backend uniquement)
# ============================================================================

# ⚠️ CRITIQUE : Clé secrète pour signer les tokens JWT et les sessions.
# Générez-en une nouvelle avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
NEXUSDL_SECRET_KEY=change-me-to-a-secure-random-string-at-least-64-chars-long

# Identifiants de l'administrateur par défaut (à changer en production)
NEXUSDL_ADMIN_EMAIL=admin@nexusdl.local
NEXUSDL_ADMIN_PASSWORD=ChangeThisPassword123!

# Clé API optionnelle pour les accès externes sécurisés (laisser vide si non utilisé)
# Générez-en une avec : python -c "import secrets; print('nxd_' + secrets.token_hex(32))"
NEXUSDL_API_KEY=

# ============================================================================
# 3. RÉSEAU & CORS (Backend uniquement)
# ============================================================================

# Hôte et port d'écoute du serveur (0.0.0.0 permet l'accès depuis l'extérieur dans Docker)
HOST=127.0.0.1
PORT=8000

# Origines autorisées pour le CORS (séparées par des virgules, sans espaces)
# En production, remplacez par l'URL réelle de votre frontend (ex: https://nexusdldev.netlify.app)
NEXUSDL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# 4. CHEMINS DE STOCKAGE & BASE DE DONNÉES (Backend uniquement)
# ============================================================================

# Répertoire racine pour toutes les données persistantes
NEXUSDL_DATA_DIR=./data

# Sous-répertoires (seront créés automatiquement s'ils n'existent pas)
NEXUSDL_DOWNLOAD_DIR=./data/downloads
NEXUSDL_LIBRARY_DIR=./data/library
NEXUSDL_CACHE_DIR=./data/cache
NEXUSDL_LOG_DIR=./data/logs

# Chemin de la base de données SQLite
NEXUSDL_DB_PATH=./data/nexusdl.db

# URL de la base de données (SQLite par défaut, ou PostgreSQL en production)
# Exemple PostgreSQL : postgresql://user:password@localhost:5432/nexusdl
DATABASE_URL=sqlite:///./data/nexusdl.db

# ============================================================================
# 5. PERFORMANCE & LIMITES (Backend uniquement)
# ============================================================================

# Nombre maximum de tâches de téléchargement simultanées
NEXUSDL_MAX_CONCURRENT_DOWNLOADS=3

# Nombre maximum de pages téléchargées simultanément par tâche
NEXUSDL_MAX_CONCURRENT_PAGES=5

# Timeout des requêtes HTTP en secondes
NEXUSDL_REQUEST_TIMEOUT=30

# ============================================================================
# 6. FRONTEND NEXT.JS (Utilisé par Netlify / Vercel / Dev local)
# ============================================================================
# ⚠️ Les variables préfixées par NEXT_PUBLIC_ sont exposées au navigateur.
# Ne mettez JAMAIS de secrets ici.

# URL de l'API backend (utilisez un chemin relatif pour profiter du proxy Netlify)
NEXT_PUBLIC_API_URL=/api/v1

# URL du WebSocket backend (doit être une URL absolue avec wss:// en production)
# Exemple production : wss://nexus-dl-production.up.railway.app/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Méta-données exposées au client
NEXT_PUBLIC_APP_NAME=NexusDL
NEXT_PUBLIC_APP_VERSION=0.1.0

# ============================================================================
# 7. BUILD & DÉPLOIEMENT (Spécifique aux plateformes)
# ============================================================================

# Force l'utilisation de Node.js 20 sur Netlify/Vercel
NODE_VERSION=20

# Force l'affichage des logs Python en temps réel (utile pour le débogage)
PYTHONUNBUFFERED=1

# ============================================================================
# 8. CORRECTIONS SPÉCIFIQUES RAILWAY (Ignorer en local)
# ============================================================================

# Désactive la vérification d'attestation GitHub pour l'installation de Python par mise
MISE_PYTHON_GITHUB_ATTESTATIONS=false

# Indique à Railpack d'installer automatiquement les dépendances système de Playwright
RAILPACK_PYTHON_PLAYWRIGHT_INSTALL=1
