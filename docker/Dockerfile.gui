# ============================================================================
# NEXUSDL - Dockerfile GUI (PyQt6 + noVNC)
# ============================================================================
# Interface graphique accessible via navigateur web (noVNC)
# Compatible : Docker local, VPS, Railway, Render, AWS, etc.
#
# Build :
#   docker build -f docker/Dockerfile.gui -t nexusdl-gui:latest .
#
# Run :
#   docker run -d -p 6080:6080 -p 5900:5900 --name nexusdl-gui nexusdl-gui:latest
#
# Accès :
#   http://localhost:6080/vnc.html (noVNC - navigateur)
#   VNC client : localhost:5900 (password: nexusdl)
# ============================================================================

# ============================================================================
# STAGE 1 : BUILDER (installation des dépendances Python)
# ============================================================================
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Dépendances système pour compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    curl \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copier les fichiers de dépendances
COPY pyproject.toml ./
COPY requirements*.txt ./
COPY README.md ./

# Installer les dépendances Python (GUI)
RUN pip install --upgrade pip setuptools wheel && \
    if [ -f requirements-gui.txt ]; then \
        pip install -r requirements-gui.txt; \
    elif [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi

# Copier le code source et installer le package
COPY src/ ./src/
RUN pip install -e .

# Installer Playwright + Chromium
RUN playwright install --with-deps chromium

# ============================================================================
# STAGE 2 : RUNTIME (Ubuntu avec GUI + noVNC)
# ============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    SCREEN_WIDTH=1920 \
    SCREEN_HEIGHT=1080 \
    SCREEN_DEPTH=24 \
    VNC_PORT=5900 \
    NOVNC_PORT=6080 \
    VNC_PASSWORD=nexusdl \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NEXUSDL_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    QT_QPA_PLATFORM=xcb \
    # ⚠️ CRITIQUE : PYTHONPATH pour trouver nexusdl
    PYTHONPATH=/app/src:/app

WORKDIR /app

# ============================================================================
# INSTALLATION DES DÉPENDANCES SYSTÈME POUR LA GUI
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python 3.12
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    python3-pip \
    # Serveur d'affichage virtuel
    xvfb \
    x11-utils \
    x11-xserver-utils \
    # VNC server
    x11vnc \
    # noVNC (accès web)
    novnc \
    websockify \
    # Gestionnaire de fenêtres léger
    fluxbox \
    # Dépendances Qt6 / PyQt6
    libgl1-mesa-glx \
    libegl1-mesa \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxcb-shape0 \
    libxcb-cursor0 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libfontconfig1 \
    fonts-dejavu-core \
    fonts-liberation \
    fonts-noto-color-emoji \
    # Playwright runtime
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libwayland-client0 \
    # Utilitaires
    curl \
    wget \
    ca-certificates \
    procps \
    net-tools \
    supervisor \
    dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# COPIER L'ENVIRONNEMENT PYTHON DEPUIS LE BUILDER
# ============================================================================
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /root/.cache/ms-playwright /root/.cache/ms-playwright
COPY --from=builder /app /app

# Créer un lien symbolique pour python
RUN ln -sf /usr/local/bin/python3.12 /usr/local/bin/python && \
    ln -sf /usr/local/bin/python3.12 /usr/local/bin/python3

# ============================================================================
# CONFIGURATION SUPERVISOR (gestion des processus)
# ============================================================================
RUN mkdir -p /var/log/supervisor

COPY docker/supervisord-gui.conf /etc/supervisor/conf.d/supervisord.conf

# ============================================================================
# CONFIGURATION FLUXBOX (gestionnaire de fenêtres)
# ============================================================================
RUN mkdir -p /root/.fluxbox && \
    echo "session.screen0.toolbar.visible: false" > /root/.fluxbox/init && \
    echo "session.screen0.fullMaximization: true" >> /root/.fluxbox/init

# ============================================================================
# CONFIGURATION NOVNC
# ============================================================================
RUN ln -sf /usr/share/novnc/vnc.html /usr/share/novnc/index.html

# ============================================================================
# CRÉER LES DOSSIERS NÉCESSAIRES
# ============================================================================
RUN mkdir -p /app/data/downloads /app/data/library \
             /app/logs /app/cache /app/config \
             /tmp/.X11-unix \
    && chmod -R 777 /app/data /app/logs /app/cache /app/config /tmp/.X11-unix

# ============================================================================
# SCRIPT D'ENTRÉE
# ============================================================================
COPY docker/entrypoint-gui.sh /entrypoint-gui.sh
RUN chmod +x /entrypoint-gui.sh

# ============================================================================
# EXPOSER LES PORTS
# ============================================================================
# noVNC (accès web)
EXPOSE ${NOVNC_PORT}
# VNC (accès client VNC)
EXPOSE ${VNC_PORT}

# ============================================================================
# HEALTHCHECK
# ============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${NOVNC_PORT}/vnc.html || exit 1

# ============================================================================
# POINT D'ENTRÉE
# ============================================================================
ENTRYPOINT ["/entrypoint-gui.sh"]
