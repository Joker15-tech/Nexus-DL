# ============================================================================
# NEXUSDL - Dockerfile Web (Nginx + FastAPI + Next.js)
# ============================================================================
# Architecture :
#   Nginx (port 80) → FastAPI (port 8001) + Next.js (port 3000)
# ============================================================================

# ============================================================================
# STAGE 1 : BUILD FRONTEND (Next.js)
# ============================================================================
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY src/nexusdl/interfaces/web/frontend/package.json ./
COPY src/nexusdl/interfaces/web/frontend/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY src/nexusdl/interfaces/web/frontend/ ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build en mode standalone (nécessaire pour Nginx)
RUN echo 'module.exports = { output: "standalone" }' >> next.config.cjs || true
RUN pnpm build

# ============================================================================
# STAGE 2 : BUILD BACKEND (Python)
# ============================================================================
FROM python:3.12-slim AS backend-builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ curl git pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml requirements*.txt README.md ./

RUN pip install --upgrade pip setuptools wheel && \
    if [ -f requirements-web.txt ]; then \
        pip install -r requirements-web.txt; \
    else \
        pip install -r requirements.txt; \
    fi

COPY src/ ./src/
RUN pip install -e .

RUN playwright install --with-deps chromium

# ============================================================================
# STAGE 3 : RUNTIME (Nginx + Python + Node.js)
# ============================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NEXUSDL_ENV=production \
    PORT=80 \
    PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    DEBIAN_FRONTEND=noninteractive \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    PYTHONPATH=/app/src:/app

WORKDIR /app

# ============================================================================
# INSTALLATION DES DÉPENDANCES SYSTÈME
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Nginx (reverse proxy)
    nginx \
    # Supervisor (gestion des processus)
    supervisor \
    # Node.js (pour Next.js standalone)
    nodejs \
    curl \
    ca-certificates \
    # Playwright runtime
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    libatspi2.0-0 libx11-6 libxcb1 libxext6 libwayland-client0 \
    fonts-liberation fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# COPIER DEPUIS LES BUILDERS
# ============================================================================

# Python packages
COPY --from=backend-builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=backend-builder /usr/local/bin /usr/local/bin
COPY --from=backend-builder /root/.cache/ms-playwright /root/.cache/ms-playwright
COPY --from=backend-builder /app /app

# Frontend Next.js standalone
COPY --from=frontend-builder /frontend/.next/standalone /app/frontend/standalone
COPY --from=frontend-builder /frontend/.next/static /app/frontend/standalone/.next/static
COPY --from=frontend-builder /frontend/public /app/frontend/standalone/public

# ============================================================================
# CONFIGURATION NGINX
# ============================================================================

# Supprimer la config par défaut de Nginx
RUN rm -f /etc/nginx/nginx.conf /etc/nginx/sites-enabled/default

# Copier notre configuration Nginx
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Créer les dossiers de logs Nginx
RUN mkdir -p /var/log/nginx /var/log/supervisor && \
    touch /var/log/nginx/access.log /var/log/nginx/error.log

# ============================================================================
# CONFIGURATION SUPERVISOR
# ============================================================================

COPY docker/supervisord-web.conf /etc/supervisor/conf.d/supervisord.conf

# ============================================================================
# DOSSIERS ET PERMISSIONS
# ============================================================================

RUN mkdir -p /app/data/downloads /app/data/library \
             /app/logs /app/cache /app/config \
    && chmod -R 777 /app/data /app/logs /app/cache /app/config

# ============================================================================
# HEALTHCHECK
# ============================================================================

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# ============================================================================
# EXPOSITION DU PORT
# ============================================================================

# Un seul port exposé : Nginx
EXPOSE 80

# ============================================================================
# POINT D'ENTRÉE : Supervisor gère les 3 processus
# ============================================================================

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
