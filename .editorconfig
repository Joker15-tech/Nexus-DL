# ============================================================================
# NEXUSDL - EditorConfig
# ============================================================================
# EditorConfig aide les développeurs à maintenir des styles de code cohérents
# entre différents éditeurs et IDE.
#
# Documentation : https://editorconfig.org
#
# Installation des plugins :
#   - VS Code       : Extension "EditorConfig for VS Code"
#   - JetBrains     : Intégré nativement (PyCharm, WebStorm, etc.)
#   - Vim/Neovim    : Plugin "editorconfig/editorconfig-vim"
#   - Sublime Text  : Package "EditorConfig"
#   - Emacs         : Package "editorconfig-emacs"
# ============================================================================

# Indique que c'est le fichier racine (ne pas chercher plus haut)
root = true

# ============================================================================
# RÈGLES PAR DÉFAUT (appliquées à tous les fichiers)
# ============================================================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ============================================================================
# PYTHON (*.py)
# ============================================================================
# Conforme à PEP 8 et à la configuration Ruff (line-length = 100)
[*.py]
indent_size = 4
max_line_length = 100

# ============================================================================
# JAVASCRIPT & TYPESCRIPT
# ============================================================================
# Conforme à Prettier et ESLint du frontend Next.js
[*.{js,jsx,mjs,cjs}]
indent_size = 2

[*.{ts,tsx,mts,cts}]
indent_size = 2

# ============================================================================
# FICHIERS DE CONFIGURATION
# ============================================================================

# JSON
[*.json]
indent_size = 2

# JSON avec commentaires (tsconfig.json, etc.)
[*.jsonc]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# TOML (pyproject.toml, Cargo.toml, etc.)
[*.toml]
indent_size = 2

# INI
[*.ini]
indent_size = 2

# ============================================================================
# MARKDOWN
# ============================================================================
# IMPORTANT : Ne pas supprimer les espaces de fin de ligne
# (utilisés pour les sauts de ligne en Markdown)
[*.md]
trim_trailing_whitespace = false
indent_size = 2
max_line_length = 100

# ============================================================================
# STYLES (CSS, SCSS, SASS, LESS)
# ============================================================================
[*.{css,scss,sass,less}]
indent_size = 2

# ============================================================================
# HTML & TEMPLATES
# ============================================================================
[*.{html,htm}]
indent_size = 2

[*.{vue,svelte,astro}]
indent_size = 2

# ============================================================================
# DOCKER
# ============================================================================
[Dockerfile*]
indent_size = 4

[*.{dockerfile,docker}]
indent_size = 4

# ============================================================================
# MAKEFILE
# ============================================================================
# IMPORTANT : Make exige des TABS, pas des espaces !
[Makefile]
indent_style = tab

[*makefile*]
indent_style = tab

# ============================================================================
# SHELL SCRIPTS
# ============================================================================
[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

# ============================================================================
# POWERSHELL
# ============================================================================
[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

# ============================================================================
# FICHIERS DE DONNÉES
# ============================================================================

# CSV
[*.csv]
indent_size = 4

# TSV
[*.tsv]
indent_style = tab

# ============================================================================
# GRAPHIQUES & SVG
# ============================================================================
[*.svg]
indent_size = 2

# ============================================================================
# FICHIERS DE VERROUILLAGE (NE PAS MODIFIER)
# ============================================================================
# Ces fichiers sont générés automatiquement et ne doivent pas être formatés
[*-lock.{json,yaml,yml}]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

[pnpm-lock.yaml]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

[package-lock.json]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

[yarn.lock]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

[Pipfile.lock]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

[poetry.lock]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

# ============================================================================
# IMAGES & BINAIRES (NE PAS TOUCHER)
# ============================================================================
[*.{png,jpg,jpeg,gif,ico,webp,avif,bmp,svg}]
indent_size = ignore

[*.{woff,woff2,ttf,otf,eot}]
indent_size = ignore

[*.{pdf,zip,tar,gz,bz2,7z,rar}]
indent_size = ignore

[*.{exe,dll,so,dylib,bin}]
indent_size = ignore

# ============================================================================
# BASES DE DONNÉES
# ============================================================================
[*.{db,sqlite,sqlite3}]
indent_size = ignore

# ============================================================================
# FICHIERS SPÉCIFIQUES NEXUSDL
# ============================================================================

# Fichiers de configuration NexusDL
[nexus.dl]
indent_size = 2

# Fichiers de traduction
[*.{po,mo,properties}]
indent_size = 2

# Fichiers GraphQL
[*.{graphql,gql}]
indent_size = 2

# Protobuf
[*.proto]
indent_size = 2

# Terraform
[*.{tf,tfvars}]
indent_size = 2

# Kubernetes
[*.{kube,k8s}]
indent_size = 2

# ============================================================================
# FICHIERS WINDOWS (CRLF)
# ============================================================================
# Certains outils Windows exigent CRLF
[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4

# ============================================================================
# GIT
# ============================================================================
[*.git{config,attributes,ignore}]
indent_size = 4

# ============================================================================
# ENVIRONNEMENT
# ============================================================================
[*.env*]
indent_size = 2
trim_trailing_whitespace = false

# ============================================================================
# NOTES
# ============================================================================
[*.{todo,notes}]
indent_size = 2

# ============================================================================
# FIN DU FICHIER
# ============================================================================
