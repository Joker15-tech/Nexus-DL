# ==============================================================================
#  NexusDL — .editorconfig
# ==============================================================================
#  Configuration universelle des éditeurs supportant EditorConfig.
#
#  Support natif ou via plugin :
#    - VS Code        : extension "EditorConfig for VS Code"
#    - JetBrains      : natif depuis 2019.3
#    - Vim/Neovim     : plugin "editorconfig-vim"
#    - Emacs          : package "editorconfig"
#    - Sublime Text   : package "EditorConfig"
#    - Atom           : package "editorconfig"
#    - Eclipse        : plugin "EditorConfig"
#    - Visual Studio  : extension "EditorConfig"
#
#  Site officiel : https://editorconfig.org/
#
#  Priorité des règles :
#    Les sections les plus spécifiques (dernières) écrasent
#    les sections plus génériques (premières).
#
#  Copyright (C) 2026 NEXUS-QUANTUM
#  SPDX-License-Identifier: GPL-3.0-or-later
# ==============================================================================

# Indique que ce fichier est la racine du projet.
# Les éditeurs ne chercheront PAS de .editorconfig dans les dossiers parents.
root = true


# ==============================================================================
#  1. RÈGLE PAR DÉFAUT — TOUS LES FICHIERS
# ==============================================================================
#  Règles de base appliquées à tous les fichiers, sauf override ci-dessous.
# ==============================================================================

[*]
# --- Encodage ---
charset = utf-8
# Encodage UTF-8 sans BOM (recommandé pour tout code source)
# Options : latin1, utf-8, utf-8-bom, utf-16be, utf-16le

# --- Fins de ligne ---
end_of_line = lf
# LF (Unix) partout, même sous Windows (voir .gitattributes)

# --- Indentation ---
indent_style = space
indent_size = 4
# 4 espaces par défaut (standard Python et la plupart des langages)

# --- Espaces ---
trim_trailing_whitespace = true
insert_final_newline = true

# --- Largeur max (informatif pour les éditeurs qui le supportent) ---
max_line_length = 100

# --- Caractères ---
# Certains éditeurs supportent ces options
# (elles ne sont PAS dans la spec officielle EditorConfig mais largement supportées)
# tab_width = 4       # Largeur d'affichage d'une tabulation
# spellcheck = false  # Vérification orthographique


# ==============================================================================
#  2. PYTHON
# ==============================================================================
#  Standard PEP 8 + conventions NexusDL.
# ==============================================================================

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100
# PEP 8 recommande 79, mais NexusDL utilise 100 (comme Black/ruff)
# Cohérent avec `line-length = 100` dans pyproject.toml

[*.{pyi,pyx,pxd,pxi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.pyw]
indent_style = space
indent_size = 4
max_line_length = 100


# ==============================================================================
#  3. FRONTEND — JAVASCRIPT / TYPESCRIPT
# ==============================================================================
#  Standard : 2 espaces (convention JS/TS dominante).
# ==============================================================================

[*.{js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{ts,tsx,mts,cts}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{vue,svelte,astro}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{json,json5,jsonc}]
indent_style = space
indent_size = 2

[*.{css,scss,sass,less,styl}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.tcss]
# Fichiers Textual CSS (NexusDL CLI)
indent_style = space
indent_size = 2
max_line_length = 100

[*.html]
indent_style = space
indent_size = 2
max_line_length = 100

[*.htm]
indent_style = space
indent_size = 2
max_line_length = 100


# ==============================================================================
#  4. DATA & CONFIG
# ==============================================================================

[*.{yaml,yml}]
indent_style = space
indent_size = 2
# Standard YAML : 2 espaces

[*.{toml,ini,cfg,conf,properties}]
indent_style = space
indent_size = 2

[*.{env,env.*}]
indent_style = space
indent_size = 2

[*.{xml,xsd,xsl,svg}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 2
max_line_length = 100

[*.graphql]
indent_style = space
indent_size = 2

[*.gql]
indent_style = space
indent_size = 2

[*.proto]
indent_style = space
indent_size = 2


# ==============================================================================
#  5. DOCUMENTATION
# ==============================================================================

[*.{md,markdown,mdown,mkd,mkdn,mkdx}]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false
# ⚠️ Ne PAS supprimer les espaces en fin de ligne dans Markdown
#    (nécessaires pour les <br> implicites, les doubles espaces)

[*.{rst,rst.txt}]
indent_style = space
indent_size = 4
max_line_length = 100
trim_trailing_whitespace = false

[*.{adoc,asciidoc,asc}]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false

[*.txt]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.tex]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false


# ==============================================================================
#  6. SCRIPTS & SHELLS
# ==============================================================================

[*.{sh,bash,zsh,ksh,csh,fish}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.ps1]
# PowerShell : 4 espaces (convention Microsoft)
indent_style = space
indent_size = 4
max_line_length = 100

[*.psm1]
indent_style = space
indent_size = 4
max_line_length = 100

[*.psd1]
indent_style = space
indent_size = 4

[*.bat]
# ⚠️ Windows batch : CRLF obligatoire
end_of_line = crlf
indent_style = space
indent_size = 2

[*.cmd]
# ⚠️ Windows command : CRLF obligatoire
end_of_line = crlf
indent_style = space
indent_size = 2

[Makefile]
# Makefile : TABULATIONS obligatoires pour les recettes !
indent_style = tab
indent_size = 4

[makefile]
indent_style = tab
indent_size = 4

[GNUmakefile]
indent_style = tab
indent_size = 4

[justfile]
indent_style = space
indent_size = 4

[Justfile]
indent_style = space
indent_size = 4

[Rakefile]
indent_style = space
indent_size = 2


# ==============================================================================
#  7. AUTRES LANGAGES
# ==============================================================================

[*.{rs,go,swift,kt,kts,dart,scala,groovy}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,h,cpp,hpp,cc,hh,cxx,hxx}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{cs,fs,fsx,vb}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{java}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{rb,rake,gemspec}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.php]
indent_style = space
indent_size = 4
max_line_length = 100

[*.pl]
indent_style = space
indent_size = 4
max_line_length = 100

[*.pm]
indent_style = space
indent_size = 4
max_line_length = 100

[*.lua]
indent_style = space
indent_size = 2
max_line_length = 100

[*.r]
indent_style = space
indent_size = 2
max_line_length = 100

[*.R]
indent_style = space
indent_size = 2
max_line_length = 100

[*.jl]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{m,mm}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{clj,cljs,cljc,edn}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{ex,exs}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{erl,hrl}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ml,mli}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{hs,lhs}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.elm]
indent_style = space
indent_size = 4
max_line_length = 100

[*.tf]
indent_style = space
indent_size = 2
max_line_length = 100

[*.tfvars]
indent_style = space
indent_size = 2

[*.hcl]
indent_style = space
indent_size = 2


# ==============================================================================
#  8. FICHIERS SPÉCIFIQUES NEXUSDL
# ==============================================================================

[nexus.dl]
# Manifestes de dossier — YAML
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[sites.yaml]
# Configuration des sites — 2 espaces
indent_style = space
indent_size = 2

[config.example.yaml]
# Config exemple — 2 espaces
indent_style = space
indent_size = 2

[requirements.txt]
# Fichier de dépendances — pas d'indentation
indent_style = space
indent_size = 0

[requirements-dev.txt]
indent_style = space
indent_size = 0

[requirements-web.txt]
indent_style = space
indent_size = 0

[requirements-gui.txt]
indent_style = space
indent_size = 0

[requirements-all.txt]
indent_style = space
indent_size = 0

[pyproject.toml]
indent_style = space
indent_size = 2

[tox.ini]
indent_style = space
indent_size = 4

[.python-version]
indent_style = space
indent_size = 0
insert_final_newline = true

[.gitignore]
indent_style = space
indent_size = 0

[.dockerignore]
indent_style = space
indent_size = 0

[.gitattributes]
indent_style = space
indent_size = 0

[.pre-commit-config.yaml]
indent_style = space
indent_size = 2

[.editorconfig]
indent_style = space
indent_size = 2


# ==============================================================================
#  9. FICHIERS SPÉCIAUX (par nom exact)
# ==============================================================================

[LICENSE]
indent_style = space
indent_size = 0
trim_trailing_whitespace = true
insert_final_newline = true

[COPYING]
indent_style = space
indent_size = 0

[CHANGELOG.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[CONTRIBUTING.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[CODE_OF_CONDUCT.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[SECURITY.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[SECURITY_HALL_OF_FAME.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[CONTRIBUTORS.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[README.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Dockerfile]
indent_style = space
indent_size = 4
max_line_length = 100

[Dockerfile.web]
indent_style = space
indent_size = 4
max_line_length = 100

[Dockerfile.gui]
indent_style = space
indent_size = 4
max_line_length = 100

[docker-compose.yml]
indent_style = space
indent_size = 2

[docker-compose.dev.yml]
indent_style = space
indent_size = 2


# ==============================================================================
#  10. FICHIERS GÉNÉRÉS — NE PAS TOUCHER
# ==============================================================================
#  Certains fichiers sont générés automatiquement.
#  On peut marquer certains d'entre eux comme "read-only" si l'éditeur le supporte.
# ==============================================================================

[uv.lock]
indent_style = space
indent_size = 2
# Ce fichier est généré par `uv` — ne pas éditer manuellement

[pnpm-lock.yaml]
indent_style = space
indent_size = 2
# Généré par pnpm — ne pas éditer manuellement

[package-lock.json]
indent_style = space
indent_size = 2
# Généré par npm — ne pas éditer manuellement

[src/nexusdl/version.py]
# Généré par hatch-vcs — ne pas éditer manuellement
indent_style = space
indent_size = 4


# ==============================================================================
#  11. FICHIERS À EXCLURE (pour éditeurs supportant cette option)
# ==============================================================================
#  Certains éditeurs (VS Code, JetBrains) supportent une directive d'exclusion.
#  Cela évite d'indexer/ouvrir ces fichiers par erreur.
# ==============================================================================

[.venv/**]
# Environnement virtuel — exclu de l'indexation
charset = utf-8

[node_modules/**]
# Dépendances Node.js — exclues
charset = utf-8

[.git/**]
# Fichiers Git internes — exclus
charset = utf-8

[.tox/**]
charset = utf-8

[.nox/**]
charset = utf-8

[.pytest_cache/**]
charset = utf-8

[.mypy_cache/**]
charset = utf-8

[.ruff_cache/**]
charset = utf-8

[htmlcov/**]
charset = utf-8

[build/**]
charset = utf-8

[dist/**]
charset = utf-8

[.next/**]
charset = utf-8


# ==============================================================================
#  12. NOTES & RAPPELS
# ==============================================================================
#
#  IMPORTANT :
#    - `indent_style = tab` + `indent_size = N` signifie :
#      indentation avec des tabulations, chaque tab = N colonnes.
#
#    - `indent_style = space` + `indent_size = N` signifie :
#      indentation avec N espaces.
#
#    - `insert_final_newline = true` :
#      ajoute automatiquement un saut de ligne en fin de fichier
#      (conforme POSIX, évite les warnings Git).
#
#    - `trim_trailing_whitespace = true` :
#      supprime les espaces/tabs en fin de ligne à la sauvegarde.
#      ⚠️ Attention avec Markdown (utile pour les sauts de ligne).
#
#    - `charset = utf-8` :
#      UTF-8 SANS BOM. Pour forcer avec BOM : `utf-8-bom`
#      (déconseillé sauf besoin spécifique).
#
#    - `max_line_length` :
#      Option NON OFFICIELLE d'EditorConfig, mais supportée par de
#      nombreux éditeurs (VS Code, JetBrains). Utile pour les linters.
#
#  CONVENTIONS NEXUSDL :
#    - Python       : 4 espaces, 100 cols
#    - JS/TS        : 2 espaces, 100 cols
#    - YAML/JSON    : 2 espaces
#    - Markdown     : 2 espaces, trailing whitespace autorisé
#    - Makefile     : tabulations (obligatoire)
#    - Windows .bat : CRLF (obligatoire)
#    - Fins de ligne : LF partout (sauf .bat/.cmd)
#
#  OUTILS LIÉS :
#    - .gitattributes : normalisation côté Git
#    - pyproject.toml : ruff (line-length = 100)
#    - .pre-commit-config.yaml : vérifications avant commit
#
#  DOCUMENTATION :
#    - https://editorconfig.org/
#    - https://spec.editorconfig.org/
#    - https://github.com/editorconfig/editorconfig/wiki/EditorConfig-Properties
#
# ==============================================================================
