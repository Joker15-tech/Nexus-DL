# ==============================================================================
#  4. FICHIERS GÉNÉRÉS — EXCLUS DE L'EXPORT
# ==============================================================================
#  `git archive` ne les inclura PAS (utile pour les releases).
#  `export-ignore` = exclu des archives de release.
# ==============================================================================

# --- Configuration de développement ---
.github/         export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
.gitmodules      export-ignore
.editorconfig    export-ignore
.pre-commit-config.yaml  export-ignore
.secrets.baseline        export-ignore
.yamllint        export-ignore
.yamllint.yaml   export-ignore
.yamllint.yml    export-ignore
.cz.toml         export-ignore
.cz.yaml         export-ignore

# --- Tests (optionnel : ne pas distribuer) ---
tests/           export-ignore
.tox/            export-ignore
.nox/            export-ignore
.pytest_cache/   export-ignore
.mypy_cache/     export-ignore
.ruff_cache/     export-ignore
.coverage        export-ignore
coverage.xml     export-ignore
htmlcov/         export-ignore

# --- Frontend (build séparé) ---
src/nexusdl/interfaces/web/frontend/  export-ignore

# --- Docs (distribué séparément) ---
docs/            export-ignore    # Décommenter si docs distribuées séparément
                                 # Sinon laisser commenté pour inclure dans l'archive

# --- Scripts dev ---
scripts/         export-ignore    # Décommenter si scripts dev non distribués

# --- Divers ---
.dockerignore    export-ignore
Dockerfile*      export-ignore
docker/          export-ignore
docker-compose*.yml  export-ignore


# ==============================================================================
#  5. DÉTECTION LINGUISTIQUE (STATS GITHUB)
# ==============================================================================
#  Force GitHub Linguist à classifier correctement les fichiers.
# ==============================================================================

# --- Fichiers exclus des statistiques ---
*.min.js         linguist-generated=true
*.min.css        linguist-generated=true
*.map            linguist-generated=true
*.lock           linguist-generated=true
uv.lock          linguist-generated=true
pnpm-lock.yaml   linguist-generated=true
package-lock.json linguist-generated=true

# --- Fichiers de documentation (exclus du code) ---
docs/**          linguist-documentation=true
*.md             linguist-documentation=true
*.rst            linguist-documentation=true
*.txt            linguist-documentation=true

# --- Fichiers de config (exclus du code) ---
*.yaml           linguist-detectable=true
*.yml            linguist-detectable=true
*.json           linguist-detectable=false
*.toml           linguist-detectable=false
*.ini            linguist-detectable=false
*.cfg            linguist-detectable=false

# --- Vendeurs (exclus) ---
node_modules/**  linguist-vendored=true
.venv/**         linguist-vendored=true
venv/**          linguist-vendored=true
vendor/**        linguist-vendored=true
third_party/**   linguist-vendored=true
external/**      linguist-vendored=true

# --- Force le langage de certains fichiers ---
*.py             linguist-language=Python
*.pyi            linguist-language=Python
*.tcss           linguist-language=CSS
justfile         linguist-language=Makefile
Justfile         linguist-language=Makefile

# --- Marqueurs pour les fichiers générés (générés automatiquement) ---
src/nexusdl/version.py         linguist-generated=true
src/nexusdl/data/sites_schema.json  linguist-generated=true
