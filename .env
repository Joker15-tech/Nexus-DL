# ============================================================================
# NEXUSDL - Environment Variables (PRODUCTION - VERSION COMPLÈTE)
# ============================================================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER DANS GIT
# ⚠️ Ce fichier contient toutes les variables nécessaires pour Railway + Netlify
# ============================================================================

# ============================================================================
# 1. CONFIGURATION GÉNÉRALE
# ============================================================================
NEXUSDL_ENV=production
NEXUSDL_LOG_LEVEL=INFO
NEXUSDL_APP_NAME=NexusDL
NEXUSDL_APP_VERSION=0.1.0
PYTHONUNBUFFERED=1

# ============================================================================
# 2. SÉCURITÉ & AUTHENTIFICATION
# ============================================================================
# Clé secrète JWT (64 caractères minimum, générée cryptographiquement)
NEXUSDL_SECRET_KEY=DQXuIo2-1s7HKiVS7I_XVSxQPhJtm5opiR70iI5T7plgZ2s3PjwLNUrmibAcV3zKbAa3mDlLzBvV4hYXmAqkcA

# Identifiants administrateur
NEXUSDL_ADMIN_EMAIL=drxenon487@gmail.com
NEXUSDL_ADMIN_PASSWORD=Nexus2026@

# Clé API pour accès externes (préfixe nxd_)
NEXUSDL_API_KEY=nxd_f1c8984441aacdabe89ca4b24649a1e2ae83b2fcc15727f8b54cc057ce48f726

# ============================================================================
# 3. RÉSEAU & CORS
# ============================================================================
# Hôte d'écoute (0.0.0.0 pour accepter les connexions externes dans Docker)
HOST=0.0.0.0

# Port d'écoute (Railway injecte automatiquement $PORT, mais on définit une valeur par défaut)
PORT=8000

# Origines CORS autorisées (séparées par des virgules, SANS espaces)
# ⚠️ CRITIQUE : Doit inclure l'URL exacte de votre frontend Netlify
NEXUSDL_CORS_ORIGINS=https://nexusdldev.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# 4. CHEMINS DE STOCKAGE (Railway/Docker)
# ============================================================================
# Répertoire racine pour toutes les données persistantes
NEXUSDL_DATA_DIR=/app/data

# Sous-répertoires
NEXUSDL_DOWNLOAD_DIR=/app/data/downloads
NEXUSDL_LIBRARY_DIR=/app/data/library
NEXUSDL_CACHE_DIR=/app/cache
NEXUSDL_LOG_DIR=/app/logs
NEXUSDL_CONFIG_DIR=/app/config

# Base de données SQLite
NEXUSDL_DB_PATH=/app/data/nexusdl.db
DATABASE_URL=sqlite:////app/data/nexusdl.db

# ============================================================================
# 5. PERFORMANCE & LIMITES (optimisé pour 1GB RAM Railway)
# ============================================================================
# Nombre maximum de tâches de téléchargement simultanées
NEXUSDL_MAX_CONCURRENT_DOWNLOADS=3

# Nombre maximum de pages téléchargées simultanément par tâche
NEXUSDL_MAX_CONCURRENT_PAGES=5

# Timeout des requêtes HTTP en secondes
NEXUSDL_REQUEST_TIMEOUT=30

# Taille maximale des fichiers téléchargés (en bytes, 0 = illimité)
NEXUSDL_MAX_FILE_SIZE=0

# Nombre de retries pour les requêtes échouées
NEXUSDL_MAX_RETRIES=3

# Délai entre les retries (en secondes)
NEXUSDL_RETRY_DELAY=5

# ============================================================================
# 6. FRONTEND NEXT.JS (Netlify)
# ============================================================================
# URL de l'API (chemin relatif pour profiter du proxy Netlify → évite CORS)
NEXT_PUBLIC_API_URL=/api/v1

# URL WebSocket (connexion DIRECTE vers Railway, Netlify ne proxyfie pas les WS)
# ⚠️ CRITIQUE : Doit être une URL absolue avec wss:// en production
NEXT_PUBLIC_WS_URL=wss://nexus-dl-production.up.railway.app/ws

# Méta-données exposées au client
NEXT_PUBLIC_APP_NAME=NexusDL
NEXT_PUBLIC_APP_VERSION=0.1.0

# Version de Node.js pour Netlify
NODE_VERSION=20

# ============================================================================
# 7. CORRECTIONS CRITIQUES RAILWAY
# ============================================================================
# ⚠️ CRITIQUE : Désactive la vérification d'attestation GitHub pour Python via mise
# Corrige l'erreur : "No GitHub artifact attestations found for python@3.12.7"
MISE_PYTHON_GITHUB_ATTESTATIONS=false

# ⚠️ CRITIQUE : Installe automatiquement les dépendances système Playwright
# Corrige l'erreur : "Host system is missing dependencies to run browsers"
RAILPACK_PYTHON_PLAYWRIGHT_INSTALL=1

# ============================================================================
# 8. PLAYWRIGHT & SCRAPING
# ============================================================================
# Chemin vers les navigateurs Playwright (défini automatiquement par Railway)
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright

# Timeout pour le lancement de Playwright (en millisecondes)
PLAYWRIGHT_LAUNCH_TIMEOUT=60000

# Timeout pour les actions Playwright (en millisecondes)
PLAYWRIGHT_ACTION_TIMEOUT=30000

# Mode headless pour Playwright (true = pas de fenêtre visible)
PLAYWRIGHT_HEADLESS=true

# ============================================================================
# 9. LOGGING & DEBUG
# ============================================================================
# Format des logs (text ou json)
NEXUSDL_LOG_FORMAT=text

# Activer les logs détaillés pour le débogage (true/false)
NEXUSDL_DEBUG=false

# Activer les logs SQL (true/false)
NEXUSDL_SQL_LOGGING=false

# ============================================================================
# 10. INTERNATIONALISATION (i18n)
# ============================================================================
# Langue par défaut (en, fr, es, etc.)
NEXUSDL_LANGUAGE=fr

# Répertoire des traductions
NEXUSDL_TRANSLATIONS_DIR=/app/data/translations

# ============================================================================
# 11. CACHE
# ============================================================================
# Taille maximale du cache (en MB, 0 = illimité)
NEXUSDL_CACHE_MAX_SIZE=500

# Durée de vie du cache (en secondes, 0 = illimité)
NEXUSDL_CACHE_TTL=86400

# ============================================================================
# 12. WEBSOCKET
# ============================================================================
# Intervalle de ping WebSocket (en secondes)
NEXUSDL_WS_PING_INTERVAL=30

# Timeout de pong WebSocket (en secondes)
NEXUSDL_WS_PING_TIMEOUT=10

# ============================================================================
# 13. RATE LIMITING
# ============================================================================
# Nombre maximum de requêtes par minute par IP
NEXUSDL_RATE_LIMIT_PER_MINUTE=100

# ============================================================================
# 14. URLs DE RÉFÉRENCE (commentaires uniquement, pas utilisées par l'app)
# ============================================================================
# Frontend Netlify : https://nexusdldev.netlify.app
# Backend Railway  : https://nexus-dl-production.up.railway.app
# GitHub Repo      : https://github.com/JokerApocalypse-cmd/Nexus-DL
# Documentation    : https://nexus-dl-production.up.railway.app/docs
# Swagger UI       : https://nexus-dl-production.up.railway.app/docs
# ReDoc            : https://nexus-dl-production.up.railway.app/redoc
# Health check     : https://nexus-dl-production.up.railway.app/health
