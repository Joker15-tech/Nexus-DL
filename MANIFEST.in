# ============================================================================
# NEXUSDL - MANIFEST.in
# ============================================================================
# Ce fichier contrôle les fichiers inclus dans la distribution source (sdist)
# du package Python NexusDL. Il est utilisé par setuptools lors de la création
# du package avec `python -m build` ou `python setup.py sdist`.
#
# Note : Les fichiers Python sont automatiquement inclus par setuptools.
# Ce fichier sert principalement à inclure les fichiers NON-Python.
#
# Documentation : https://setuptools.pypa.io/en/latest/userguide/miscellaneous.html
# ============================================================================

# ============================================================================
# FICHIERS RACINE ESSENTIELS
# ============================================================================

# Fichiers de métadonnées
include pyproject.toml
include README.md
include LICENSE
include NOTICE
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md

# Fichiers de configuration
include .editorconfig
include .gitignore
include .gitattributes
include .python-version

# Fichiers de dépendances
include requirements.txt
include requirements-web.txt
include requirements-gui.txt
include requirements-dev.txt
include requirements-all.txt

# Fichiers de configuration outils
include tox.ini
include justfile
include Makefile
include .pre-commit-config.yaml

# ============================================================================
# FICHIERS DE DONNÉES DU CORE
# ============================================================================

# Traductions (i18n)
recursive-include src/nexusdl/data/translations *.po *.mo *.json *.yaml *.yml

# Schémas de validation
recursive-include src/nexusdl/data/schemas *.json *.yaml *.yml

# Configuration des sites de manga
recursive-include src/nexusdl/core/registry/sites *.yaml *.yml *.json

# Templates par défaut
recursive-include src/nexusdl/data/templates *.html *.jinja *.jinja2 *.txt

# Assets par défaut
recursive-include src/nexusdl/data/assets *.svg *.png *.ico *.json

# Configuration par défaut
recursive-include src/nexusdl/data/config *.yaml *.yml *.toml *.json

# ============================================================================
# BACKEND - FICHIERS STATIQUES
# ============================================================================

# Styles CSS
recursive-include src/nexusdl/interfaces/web/backend/static/css *.css

# Scripts JavaScript
recursive-include src/nexusdl/interfaces/web/backend/static/js *.js *.mjs

# Images et icônes
recursive-include src/nexusdl/interfaces/web/backend/static *.svg *.png *.jpg *.jpeg *.ico *.webp

# Polices
recursive-include src/nexusdl/interfaces/web/backend/static/fonts *.woff *.woff2 *.ttf *.otf *.eot

# Templates HTML du backend
recursive-include src/nexusdl/interfaces/web/backend/templates *.html *.jinja *.jinja2

# ============================================================================
# FRONTEND - CONFIGURATION (pas le code source, géré par Netlify)
# ============================================================================

# Configuration Next.js (nécessaire pour référence)
include src/nexusdl/interfaces/web/frontend/package.json
include src/nexusdl/interfaces/web/frontend/pnpm-lock.yaml
include src/nexusdl/interfaces/web/frontend/tsconfig.json
include src/nexusdl/interfaces/web/frontend/next.config.cjs
include src/nexusdl/interfaces/web/frontend/postcss.config.cjs
include src/nexusdl/interfaces/web/frontend/tailwind.config.*
include src/nexusdl/interfaces/web/frontend/.eslintrc*
include src/nexusdl/interfaces/web/frontend/.prettierrc*

# ============================================================================
# DOCKER & DÉPLOIEMENT
# ============================================================================

# Fichiers Docker
include Dockerfile
include .dockerignore
include docker-compose.yml
include docker-compose.yaml

# Configuration de déploiement
include netlify.toml
include railway.toml
include render.yaml
include Procfile
include fly.toml

# ============================================================================
# DOCUMENTATION
# ============================================================================

# Documentation MkDocs
recursive-include docs *.md *.yaml *.yml *.png *.jpg *.svg
include docs/mkdocs.yml

# ============================================================================
# TESTS (optionnel - pour les distributions de test)
# ============================================================================

# Fichiers de test
recursive-include tests *.py *.yaml *.yml *.json *.txt *.md

# Fixtures de test
recursive-include tests/fixtures *

# Configuration pytest
include pytest.ini
include conftest.py

# ============================================================================
# EXCLUSIONS - FICHIERS À NE PAS INCLURE
# ============================================================================

# Exclure les fichiers d'environnement (secrets)
global-exclude .env
global-exclude .env.*
global-exclude *.pem
global-exclude *.key
global-exclude *.crt
global-exclude *.cert

# Exclure les caches Python
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *$py.class
global-exclude *.so
global-exclude *.pyd

# Exclure les environnements virtuels
prune .venv
prune venv
prune env
prune ENV

# Exclure les répertoires de build
prune build/
prune dist/
prune *.egg-info/

# Exclure les caches d'outils
prune .pytest_cache/
prune .mypy_cache/
prune .ruff_cache/
prune .tox/
prune .nox/
prune htmlcov/
prune .coverage

# Exclure les dépendances Node.js
prune node_modules/
prune src/nexusdl/interfaces/web/frontend/node_modules/
prune src/nexusdl/interfaces/web/frontend/.next/
prune src/nexusdl/interfaces/web/frontend/out/

# Exclure les fichiers système
global-exclude .DS_Store
global-exclude Thumbs.db
global-exclude desktop.ini
global-exclude *.swp
global-exclude *.swo
global-exclude *~

# Exclure les logs
global-exclude *.log
prune logs/

# Exclure les bases de données locales
global-exclude *.db
global-exclude *.sqlite
global-exclude *.sqlite3

# Exclure les fichiers temporaires
global-exclude *.tmp
global-exclude *.temp
global-exclude *.bak
global-exclude *.backup
global-exclude *.old
global-exclude *.orig

# Exclure les configurations IDE spécifiques
prune .vscode/
prune .idea/

# Exclure les archives
global-exclude *.zip
global-exclude *.tar
global-exclude *.tar.gz
global-exclude *.7z
global-exclude *.rar

# Exclure les médias lourds (sauf icônes)
global-exclude *.mp4
global-exclude *.mp3
global-exclude *.wav
global-exclude *.pdf
global-exclude *.psd
global-exclude *.ai

# ============================================================================
# FIN DU FICHIER
# ============================================================================
