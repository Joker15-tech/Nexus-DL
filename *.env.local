# ============================================================================
# NEXUSDL - Environment Variables (DÉVELOPPEMENT LOCAL)
# ============================================================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER DANS GIT
# Ce fichier override .env pour le développement local uniquement.
# ============================================================================

# ============================================================================
# 1. CONFIGURATION GÉNÉRALE
# ============================================================================
NEXUSDL_ENV=development
NEXUSDL_LOG_LEVEL=DEBUG
NEXUSDL_APP_NAME=NexusDL
NEXUSDL_APP_VERSION=0.1.0
PYTHONUNBUFFERED=1

# ============================================================================
# 2. SÉCURITÉ & AUTHENTIFICATION
# ============================================================================
# Clé secrète JWT (dev uniquement, pas sécurisée)
NEXUSDL_SECRET_KEY=dev-secret-key-not-for-production-use-only-local-testing-1234567890abcdef

# Identifiants administrateur (dev)
NEXUSDL_ADMIN_EMAIL=drxenon487@gmail.com
NEXUSDL_ADMIN_PASSWORD=Nexus2026@

# Clé API (dev)
NEXUSDL_API_KEY=nxd_f1c8984441aacdabe89ca4b24649a1e2ae83b2fcc15727f8b54cc057ce48f726

# ============================================================================
# 3. RÉSEAU & CORS
# ============================================================================
# En local, on écoute sur 127.0.0.1 (pas besoin de 0.0.0.0)
HOST=127.0.0.1
PORT=8000

# CORS : autoriser le frontend local Next.js
NEXUSDL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# 4. CHEMINS DE STOCKAGE (LOCAUX)
# ============================================================================
# En local, on utilise des chemins relatifs au projet
NEXUSDL_DATA_DIR=./data
NEXUSDL_DOWNLOAD_DIR=./data/downloads
NEXUSDL_LIBRARY_DIR=./data/library
NEXUSDL_CACHE_DIR=./data/cache
NEXUSDL_LOG_DIR=./data/logs
NEXUSDL_DB_PATH=./data/nexusdl.db
DATABASE_URL=sqlite:///./data/nexusdl.db

# ============================================================================
# 5. PERFORMANCE & LIMITES (plus élevé en local)
# ============================================================================
NEXUSDL_MAX_CONCURRENT_DOWNLOADS=5
NEXUSDL_MAX_CONCURRENT_PAGES=10
NEXUSDL_REQUEST_TIMEOUT=60

# ============================================================================
# 6. FRONTEND NEXT.JS (DEV LOCAL)
# ============================================================================
# En local, le frontend appelle directement le backend sur localhost
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket local
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Méta-données frontend
NEXT_PUBLIC_APP_NAME=NexusDL
NEXT_PUBLIC_APP_VERSION=0.1.0
NODE_VERSION=20
